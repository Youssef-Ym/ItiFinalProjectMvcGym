@model ItiFinalProjectMvcGym.Models.GymClass

@{
    ViewData["Title"] = "Create Gym Class";
}

<h2>Create Gym Class</h2>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-group mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Schedule" class="form-label"></label>
                <input asp-for="Schedule" class="form-control" placeholder="e.g. Mon / Wed 6:00 PM" />
                <span asp-validation-for="Schedule" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label class="form-label">Assign Trainer</label>
                <select asp-for="TrainerId" class="form-select" asp-items="ViewBag.TrainerId">
                    <option value="">-- Choose Trainer --</option>
                </select>
                <span asp-validation-for="TrainerId" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-success">Save Class</button>
            <a asp-action="Manage" class="btn btn-secondary">Back to List</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}