@model ItiFinalProjectMvcGym.Models.Enrollment

@{
    ViewData["Title"] = "Enroll Member";
}

<h2>Enroll Member in Gym Class</h2>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-group mb-3">
                <label class="form-label">Select Member</label>
                <select asp-for="MemberId" class="form-select" asp-items="ViewBag.MemberId">
                    <option value="">-- Choose Member --</option>
                </select>
                <span asp-validation-for="MemberId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label class="form-label">Select Gym Class</label>
                <select asp-for="GymClassId" class="form-select" asp-items="ViewBag.GymClassId">
                    <option value="">-- Choose Class --</option>
                </select>
                <span asp-validation-for="GymClassId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="EnrollmentDate" class="form-label"></label>
                <input asp-for="EnrollmentDate" type="date" class="form-control" />
                <span asp-validation-for="EnrollmentDate" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-success">Enroll</button>
            <a asp-controller="GymClass" asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}