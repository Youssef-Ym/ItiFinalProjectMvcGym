@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    var sessionVal = HttpContextAccessor.HttpContext?.Session.GetString("IsAdmin");
    var isAdmin = !string.IsNullOrEmpty(sessionVal) && string.Equals(sessionVal.Trim(), "true", StringComparison.OrdinalIgnoreCase);
    var userEmail = HttpContextAccessor.HttpContext?.Session.GetString("UserEmail");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gym System</title>

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
            /* Custom Navbar Enhancements */
            .custom-navbar {
                background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
                box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
            }

            .navbar-brand {
                font-weight: 700;
                letter-spacing: 0.5px;
                font-size: 1.35rem;
                color: #38bdf8 !important;
                transition: transform 0.2s ease;
            }

                .navbar-brand:hover {
                    transform: translateY(-1px);
                }

            .nav-link {
                font-weight: 500;
                padding: 0.5rem 0.9rem !important;
                border-radius: 8px;
                transition: all 0.25s ease;
                color: #cbd5e1 !important;
            }

                .nav-link:hover {
                    color: #ffffff !important;
                    background-color: rgba(255, 255, 255, 0.08);
                    transform: translateY(-1px);
                }

                .nav-link i {
                    margin-right: 6px;
                    font-size: 1.05rem;
                }

            .user-badge {
                background: rgba(56, 189, 248, 0.12);
                color: #38bdf8;
                border: 1px solid rgba(56, 189, 248, 0.25);
                border-radius: 20px;
                padding: 0.4rem 1rem;
                font-size: 0.88rem;
                font-weight: 500;
            }

            .btn-logout {
                border-radius: 8px;
                padding: 0.4rem 1rem;
                transition: all 0.2s ease;
            }

            .admin-badge {
                font-size: 0.68rem;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                vertical-align: middle;
            }
    </style>
</head>
<body class="bg-light">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark custom-navbar sticky-top mb-4 py-2">
            <div class="container">
                <!-- Brand Logo -->
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="GymClass" asp-action="Index">
                    <i class="bi bi-activity text-info fs-3"></i>
                    <span>GYM<span class="text-white">SYSTEM</span></span>
                </a>

                <!-- Mobile Toggle Button -->
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Navbar Links -->
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1 mt-2 mt-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="GymClass" asp-action="Index">
                                <i class="bi bi-calendar3"></i>Classes
                            </a>
                        </li>

                        @if (isAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Trainer" asp-action="Index">
                                    <i class="bi bi-person-badge"></i>Trainers
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="GymClass" asp-action="Manage">
                                    <i class="bi bi-sliders"></i>Manage Classes
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Member" asp-action="Index">
                                    <i class="bi bi-people"></i>Members
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Enrollment" asp-action="Create">
                                    <i class="bi bi-person-plus"></i>Enroll Member
                                </a>
                            </li>
                        }
                    </ul>

                    <!-- User Profile / Auth Section -->
                    <ul class="navbar-nav align-items-lg-center gap-2 mt-2 mt-lg-0">
                        @if (!string.IsNullOrEmpty(userEmail))
                        {
                            <li class="nav-item d-flex align-items-center">
                                <div class="user-badge d-flex align-items-center gap-2">
                                    <i class="bi bi-person-circle fs-6"></i>
                                    <span>@userEmail</span>
                                    @if (isAdmin)
                                    {
                                        <span class="badge bg-danger admin-badge ms-1">Admin</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary admin-badge ms-1">Trainer</span>
                                    }
                                </div>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-outline-danger btn-sm btn-logout d-flex align-items-center gap-1" asp-controller="Account" asp-action="Logout">
                                    <i class="bi bi-box-arrow-right"></i> Logout
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm px-3 rounded-2 d-flex align-items-center gap-1" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right"></i> Login
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>